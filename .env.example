# ============================================================
# AI Nextcloud Organizer - environment example
# ============================================================
# Copy this file to .env for local/manual Docker testing.
# Never commit the real .env file.

# --------------------
# Ollama - REQUIRED for a new installation
# --------------------
# Must be reachable from inside the AI Organizer container.
# Do not use localhost unless Ollama runs in this same container.
OLLAMA_URL=

# Deliberately has no default. Use a model that already exists on your server.
OLLAMA_MODEL=

# --------------------
# Paperless-ngx integration - OPTIONAL
# --------------------
# If omitted, the initial default is false. After settings are saved in the
# AI Organizer admin UI, the SQLite-saved setting takes precedence on restart.
PAPERLESS_ENABLED=false

# --------------------
# Nextcloud WebDAV/OCS user authentication
# --------------------
# NEXTCLOUD_APP_PASSWORD is a Nextcloud user app password. It is NOT APP_SECRET.
NEXTCLOUD_URL=http://192.168.1.2:8080
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=

# --------------------
# Nextcloud AppAPI / ExApp authentication
# --------------------
# AppAPI supplies these in a managed ExApp deployment. They are included here
# for manual/local testing only.
APP_SECRET=
APP_USER=admin

# Optional deployment overrides; the application already has safe defaults.
# APP_ID=ai_nextcloud_organizer
# APP_VERSION=0.1.0
# AA_VERSION=4.0.0
# AI_ORGANIZER_CONFIG=/app/config.yaml
# AI_ORGANIZER_CONFIG_FILE=./config.yaml   # Compose host-side override
# AI_ORGANIZER_IMAGE=yourname/ai-nextcloud-organizer:0.1.0
# LOG_LEVEL=INFO
